# Copy with `cp .env.example .env`, then edit .env.

# ---- set volume path ----------------------------------------------------------------------------------------
# Host directory (absolute path) for the model weights. Each model takes 52-63GB; all 7 models take about 390GB.
# Only the weights of the models you start are fetched. On a DGX, a directory under the data RAID /raid is recommended.
# Replace the line below with the real path (e.g. MODELS_DIR=/raid/models) and create that directory beforehand.
# Until you do, every docker compose command stops with this message.
MODELS_DIR="${SET_VOLUME_PATH:?set volume path: edit MODELS_DIR in .env to the directory for the model weights}"
# ---------------------------------------------------------------------------------------------------------------

# Models that `docker compose up -d` starts (comma separated). Each model takes one GPU to itself.
# Choices: qwen, jev, valen, pplx, d3, glimmer, gemma
COMPOSE_PROFILES=qwen,jev,valen

# Owner of the weight files (the values of `id -u` / `id -g`). This user must be able to write to MODELS_DIR
HOST_UID=1000
HOST_GID=1000
# Hugging Face token. Every model is public and ungated, so it can stay empty (set it only to avoid rate limits)
HF_TOKEN=

# GPU each model takes (the index nvidia-smi shows). Models chosen in COMPOSE_PROFILES must not share a GPU
# (scripts/preflight.sh checks this). By default, the 4 models added later all use the free GPU 3
QWEN_GPU=0
JEV_GPU=1
VALEN_GPU=2
PPLX_GPU=3
D3_GPU=3
GLIMMER_GPU=3
GEMMA_GPU=3

# Address and ports to publish on. No server has authentication, so anyone who can reach this address can use every model.
# Ports that Docker publishes bypass host firewalls such as ufw. To restrict access, set 127.0.0.1 and use an SSH tunnel
BIND_ADDRESS=0.0.0.0
QWEN_PORT=8000
JEV_PORT=8001
VALEN_PORT=8002
PPLX_PORT=8003
D3_PORT=8004
GLIMMER_PORT=8005
GEMMA_PORT=8006

# Maximum tokens per request. Whatever the weights leave free on one 80GB GPU becomes the KV cache
#   qwen, jev: 27B in BF16 leaves a little over 10GB for KV (about 65KB/token). Qwen3.8's native limit of 262144 does not fit on one GPU
#   glimmer:   the KV cache is small (about 13KB/token), so the model's native limit fits
#   gemma:     the weights take 62.6GB and leave roughly 10GB for KV. Tune it from max_total_num_tokens in the startup log
QWEN_CONTEXT_LENGTH=131072
JEV_MAX_MODEL_LEN=131072
GLIMMER_CONTEXT_LENGTH=131072
GEMMA_CONTEXT_LENGTH=65536
